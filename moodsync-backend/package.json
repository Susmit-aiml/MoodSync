{
  "name": "moodsync-backend",
  "version": "1.0.0",
  "description": "Backend API for MoodSync Chrome Extension - Spotify OAuth, AI Mood Anchors, and Playlist Generation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "ts-node src/test/selftest.ts"
  },
  "keywords": [
    "moodsync",
    "spotify",
    "chrome-extension",
    "ai",
    "playlist-generator"
  ],
  "author": "Susmit",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/genai": "^2.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/selfsigned": "^2.0.4",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
