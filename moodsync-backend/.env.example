# ==========================================
# MoodSync Backend - Environment Variables
# ==========================================

# Server Port
PORT=3001
NODE_ENV=development

# Spotify Developer Credentials (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# Redirect URI registered in Spotify Developer Dashboard:
SPOTIFY_REDIRECT_URI=http://localhost:3001/auth/callback

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Security Secrets
# SESSION_SECRET: random 32+ character string used for session signing
SESSION_SECRET=your_random_32_character_session_secret_here
# TOKEN_ENCRYPTION_KEY: 32+ character key for AES-256 token encryption at rest
TOKEN_ENCRYPTION_KEY=your_32_character_aes_token_encryption_key_here

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/moodsync)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/moodsync?retryWrites=true&w=majority
